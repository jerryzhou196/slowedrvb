{
  "manifest_version": 3,
  "name": "slowedrvb — slowed + reverb any tab",
  "short_name": "slowedrvb",
  "version": "1.0.0",
  "description": "Slow down any tab and drench it in reverb, bass boost and 8D audio. Works on YouTube, SoundCloud and more.",
  "homepage_url": "https://slowedrvb.com/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "slowedrvb",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"]
}
